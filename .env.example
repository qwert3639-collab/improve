# ─── AI 설정 ──────────────────────────────────────────────────────────────────
# 사용할 AI 선택: claude | openai | gemini | ollama
AI_PROVIDER=claude

# AI API 키 (선택한 AI에 맞는 키 입력)
# Claude:  https://console.anthropic.com
# OpenAI:  https://platform.openai.com/api-keys
# Gemini:  https://aistudio.google.com/app/apikey
# Ollama:  API 키 불필요 (로컬 실행)
AI_API_KEY=여기에_API_키_입력

# 사용 모델 (비워두면 기본값 사용)
# Claude 권장: claude-haiku-4-5-20251001  (월 ~$4, 가성비 최고)
# OpenAI 권장: gpt-4o-mini
# Gemini 권장: gemini-1.5-flash
AI_MODEL=claude-haiku-4-5-20251001

# Ollama 서버 주소 (로컬 AI 사용 시)
# OLLAMA_BASE_URL=http://localhost:11434

# ─── 한국투자증권 KIS API ──────────────────────────────────────────────────────
# https://apiportal.koreainvestment.com 에서 발급 (소프트웨어 설치 불필요)
KIS_APP_KEY=여기에_AppKey_입력
KIS_APP_SECRET=여기에_AppSecret_입력
# KIS_IS_VIRTUAL=true  # true=모의투자(기본), false=실전투자
